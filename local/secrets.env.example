# AlphaBlokus secrets — TEMPLATE. Copy to `local/secrets.env` and fill in real values.
#
#     cp local/secrets.env.example local/secrets.env    # then edit in the real keys
#
# `local/secrets.env` is gitignored and must NEVER be committed. This .example file
# (placeholders only) is the one that ships, so a fresh clone knows what to populate.
#
# Usage — source into the environment for the command that needs it, never cat/print it:
#     set -a; source local/secrets.env; set +a
#   then run your command in the SAME shell invocation (shell state does not persist).
#
# On the Mac, S3/R2 calls also need the corporate CA bundle (Netskope TLS interception):
#     export AWS_CA_BUNDLE="$HOME/.corp-ca-bundle.pem"

# Cloudflare R2 S3-API keys (R2 dashboard → Manage R2 API Tokens → create token,
# Object Read & Write, scoped to the bucket). Endpoint/bucket are non-secret and
# live in the run config's object_store block, not here.
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Weights & Biases API key (wandb.ai → User Settings → API keys).
WANDB_API_KEY=your-wandb-api-key

# RunPod API key (runpod.io → Settings → API Keys).
RUNPOD_API_KEY=your-runpod-api-key
